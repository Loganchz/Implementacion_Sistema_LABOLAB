# ==========================================================================
# Variables de entorno - Labolab LIMS
# Copia este archivo a ".env" y completa los valores.
#   cp .env.example .env
# ==========================================================================

# --- Base de datos PostgreSQL (OBLIGATORIO) ---
# Si usas Docker Compose (recomendado), deja el host como "db":
DATABASE_URL="postgresql://labolab:labolab@db:5432/labolab_lims?schema=public"
# Si corres la app localmente SIN Docker, apunta a tu Postgres local:
# DATABASE_URL="postgresql://labolab:labolab@localhost:5432/labolab_lims?schema=public"

# --- NextAuth (OBLIGATORIO) ---
# URL base de la app (en local dejar http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"
# Secreto para firmar sesiones. GENERA UNO NUEVO con:
#   openssl rand -base64 32
NEXTAUTH_SECRET="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO"

# --- API de Abacus.AI (OPCIONAL) ---
# Solo se usa para: generación de PDFs (cotizaciones, órdenes, reportes)
# y funciones de IA. La aplicación ARRANCA y funciona sin esta clave,
# pero las descargas de PDF y las funciones de IA fallarán hasta que se
# configure un proveedor equivalente. Déjala vacía si no la tienes.
ABACUSAI_API_KEY=""
